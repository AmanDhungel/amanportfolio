# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Contact form (https://resend.com → API Keys). Without it, the form tells
# visitors to email you directly.
RESEND_API_KEY=

# Where form messages are delivered. Defaults to the email in src/content/site.ts.
CONTACT_TO_EMAIL=dhungelaman2000@gmail.com

# Sender address. Defaults to Resend's test sender, which can only deliver to
# the email you signed up to Resend with. After verifying dhungelaman.info in
# Resend, use something like: Portfolio <hello@dhungelaman.info>
CONTACT_FROM_EMAIL=

# Public origin for canonical URLs, the sitemap and Open Graph. Optional on
# Vercel, which provides the production domain automatically.
NEXT_PUBLIC_SITE_URL=
